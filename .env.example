# Puerto de escucha. En Render (y cualquier PaaS) se inyecta solo.
PORT=3000

# development | production
NODE_ENV=development

# Orígenes autorizados para CORS, separados por comas.
# OBLIGATORIO en producción: si falta, la API no arranca.
# En desarrollo, si se omite: http://localhost:5173,http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cadena de conexión Postgres.
DATABASE_URL=postgres://user:pass@localhost:5432/db
