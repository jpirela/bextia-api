    "hono": "^4.13.11",
    "tsx": "^4.23.15",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.19.0",
    "drizzle-kit": "^0.31.11"
  }
}
